<Window x:Class="Iap2Loc.Desktop.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置 · 随行定位" Width="610" Height="760" MinWidth="540" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="应用设置" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="搜索服务与身份材料会保存在当前 Windows 用户下。" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="地点搜索" Style="{StaticResource SectionTitle}" />
    <TextBlock Text="搜索服务" Style="{StaticResource Caption}" /><ComboBox x:Name="ProviderBox"><ComboBoxItem Content="自动选择（有 Key 使用高德，否则使用开放地图）" /><ComboBoxItem Content="高德地图（国内地址 / 兴趣点，需 Web 服务 Key）" /><ComboBoxItem Content="开放地图 Photon（免 Key，覆盖随地区变化）" /></ComboBox>
    <TextBlock Text="高德 Web 服务 Key" Style="{StaticResource Caption}" /><PasswordBox x:Name="AmapKeyBox" Padding="9,7" BorderBrush="#DCE5DF" />
    <TextBlock Text="在高德开放平台创建“Web 服务”类型的 Key；以加密形式保存。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    <TextBlock Text="优先搜索城市（可留空）" Style="{StaticResource Caption}" /><TextBox x:Name="CityBox" ToolTip="例如：上海、杭州、北京" />
    <Expander Header="自定义开放地图服务" Margin="0,12,0,0"><StackPanel>
     <TextBox x:Name="EndpointBox" Margin="0,8,0,0" /><TextBlock Text="兼容 Photon API。默认使用公共服务；也可指定自建服务。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="配件认证身份" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="IdentityText" TextWrapping="Wrap" FontSize="12" />
    <TextBlock Text="材料校验只检查证书与私钥是否匹配；认证是否通过以连接设备后的状态为准。身份切换对新连接生效。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,12" />
    <WrapPanel><Button Content="导入 APK / 身份文件" Click="Import_Click" Margin="0,0,6,6" /><Button Content="使用内置身份" Click="BuiltIn_Click" Margin="0,0,6,6" /><Button Content="重新检查" Click="Check_Click" Margin="0,0,0,6" /></WrapPanel>
    <TextBlock Text="导入 .pk8 时，同目录需有 certificate.p7b；APK 支持包含 offline-mfi 材料的 DiPlay 包。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" />
   </StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="组件与诊断" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,9" />
    <Button x:Name="RuntimeButton" Content="安装或修复地图组件" Click="Runtime_Click" HorizontalAlignment="Left" />
    <CheckBox x:Name="VerboseBox" Content="显示详细协议日志" Margin="0,13,0,10" />
    <Button Content="打开应用数据目录" Click="OpenData_Click" HorizontalAlignment="Left" />
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="保存设置" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" DockPanel.Dock="Right" Margin="6,0,0,0" /><Button Content="关闭" IsCancel="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" /><TextBlock Text="身份导入和切换会立即保存。" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /></DockPanel>
 </Grid>
</Window>
