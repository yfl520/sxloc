<Window x:Class="Iap2Loc.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="随行定位" Width="1440" Height="930" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="32" /></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DFE7E1" BorderThickness="0,0,0,1" Padding="24,0">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="使用说明" Click="Help_Click" /><Button Content="诊断日志" Click="Logs_Click" /><Button Content="设置" Click="Settings_Click" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#146C5C" Width="40" Height="40" CornerRadius="12" Margin="0,0,13,0"><TextBlock Text="⌖" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
     <StackPanel><TextBlock Text="随行定位" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="让位置，由你选择" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
     <Border Background="#EAF4ED" CornerRadius="12" Padding="10,5" Margin="22,0,0,0" VerticalAlignment="Center"><TextBlock Text="桌面版 1.0" Foreground="#397653" FontSize="11" /></Border>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="18,18,18,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="282" /></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
    <StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="寻找目的地" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="输入地名、详细地址或经纬度" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" ToolTip="例如：上海外滩，或 31.2304,121.4737" AutomationProperties.Name="搜索地点" />
       <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="Search_Click" />
      </Grid>
      <TextBlock x:Name="SearchHint" Text="免 Key 搜索可用；高德搜索可在设置中配置。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,5" />
      <ComboBox x:Name="HistoryBox" Visibility="Collapsed" SelectionChanged="History_Changed" Margin="0,3,0,5" ToolTip="选择历史关键词，再点击搜索" />
      <ListBox x:Name="ResultsList" MaxHeight="230" SelectionChanged="Result_Selected">
       <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,2" />
        <TextBlock Text="{Binding CoordinateText}" Foreground="#799287" FontSize="10" TextWrapping="Wrap" />
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel></Border>

     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="目标位置" Style="{StaticResource SectionTitle}" />
      <TextBlock x:Name="DestinationText" Text="地图选点 / 手动输入" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="纬度 · WGS-84" Style="{StaticResource Caption}" /><TextBox x:Name="LatitudeBox" TextChanged="Target_Edited" AutomationProperties.Name="纬度" /></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="经度 · WGS-84" Style="{StaticResource Caption}" /><TextBox x:Name="LongitudeBox" TextChanged="Target_Edited" AutomationProperties.Name="经度" /></StackPanel>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="高度（米）" Style="{StaticResource Caption}" /><TextBox x:Name="AltitudeBox" TextChanged="Target_Edited" /></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="精度（米）" Style="{StaticResource Caption}" /><TextBox x:Name="AccuracyBox" TextChanged="Target_Edited" /></StackPanel>
      </Grid>
      <TextBlock x:Name="DraftHint" Text="修改后点击“应用定位”" Foreground="#A4742E" FontSize="11" Margin="0,12,0,10" TextWrapping="Wrap" />
      <Button x:Name="ApplyButton" Content="应用定位" Style="{StaticResource PrimaryButton}" Margin="0" Padding="12,11" Click="Apply_Click" />
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <Button Content="收藏位置" Click="SaveFavorite_Click" Margin="0,0,4,0" /><Button Grid.Column="1" Content="复制坐标" Click="Copy_Click" Margin="4,0,0,0" />
      </Grid>
     </StackPanel></Border>

     <Border Style="{StaticResource Card}"><Expander Header="高级定位参数"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="发送周期（毫秒；设备订阅优先）" Style="{StaticResource Caption}" /><TextBox x:Name="RateBox" TextChanged="Target_Edited" />
      <TextBlock Text="定位质量" Style="{StaticResource Caption}" /><ComboBox x:Name="QualityBox" SelectedIndex="1" SelectionChanged="Target_SelectionChanged">
       <ComboBoxItem Content="0 · 无效" /><ComboBoxItem Content="1 · GPS 单点" /><ComboBoxItem Content="2 · 差分定位" /><ComboBoxItem Content="3 · 精密定位" /><ComboBoxItem Content="4 · 固定解" /><ComboBoxItem Content="5 · 浮动解" /><ComboBoxItem Content="6 · 估算" /><ComboBoxItem Content="7 · 人工" /><ComboBoxItem Content="8 · 模拟" />
      </ComboBox>
      <TextBlock Text="卫星数（0–99）" Style="{StaticResource Caption}" /><TextBox x:Name="SatellitesBox" TextChanged="Target_Edited" />
      <TextBlock Text="速度（米/秒；只设置上报字段）" Style="{StaticResource Caption}" /><TextBox x:Name="SpeedBox" TextChanged="Target_Edited" />
      <TextBlock Text="航向（0–359.99 度）" Style="{StaticResource Caption}" /><TextBox x:Name="BearingBox" TextChanged="Target_Edited" />
      <CheckBox x:Name="JitterPositionBox" Content="随机位置偏移（每次修改时生成一次）" Margin="0,14,0,6" Checked="Target_SelectionChanged" Unchecked="Target_SelectionChanged" />
      <TextBlock Text="偏移半径（米）" Style="{StaticResource Caption}" /><TextBox x:Name="JitterMetersBox" TextChanged="Target_Edited" />
      <CheckBox x:Name="JitterAccuracyBox" Content="随机精度（每次修改时生成一次）" Margin="0,14,0,6" Checked="Target_SelectionChanged" Unchecked="Target_SelectionChanged" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="精度下限（米）" Style="{StaticResource Caption}" /><TextBox x:Name="AccuracyMinBox" TextChanged="Target_Edited" /></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="精度上限（米）" Style="{StaticResource Caption}" /><TextBox x:Name="AccuracyMaxBox" TextChanged="Target_Edited" /></StackPanel>
      </Grid>
     </StackPanel></Expander></Border>
    </StackPanel>
   </ScrollViewer>

   <Border Grid.Column="2" CornerRadius="12" Background="White" BorderBrush="#DFE7E1" BorderThickness="1" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="57" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
     <DockPanel Margin="16,0">
      <ComboBox x:Name="DatumBox" DockPanel.Dock="Right" Width="145" SelectedIndex="0" SelectionChanged="Datum_Changed" VerticalAlignment="Center"><ComboBoxItem Content="高德地图" /><ComboBoxItem Content="开放街道地图" /></ComboBox>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="地图选点" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="点击地图或拖动标记" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
     </DockPanel>
     <Grid Grid.Row="1" Background="#E8EDE8">
      <TextBlock x:Name="MapPlaceholder" Text="正在准备地图…" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="25" />
      <wv:WebView2 x:Name="MapView" DefaultBackgroundColor="#E8EDE8" />
     </Grid>
     <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E8EEE8" Padding="15,9"><StackPanel>
      <TextBlock x:Name="AppliedText" Text="当前目标：尚未应用" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
      <TextBlock x:Name="ResolvedText" Text="所有已连接设备跟随同一目标位置" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
     </StackPanel></Border>
    </Grid>
   </Border>

   <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Padding="9,4" Click="Refresh_Click" Margin="0" /><TextBlock Text="我的设备" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" /></DockPanel>
     <TextBlock x:Name="DevicesHint" Text="先在 Windows 蓝牙设置中配对 iPhone" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,8" />
     <ComboBox x:Name="DevicesBox" DisplayMemberPath="Name" ToolTip="选择已配对的 iPhone" />
     <CheckBox x:Name="ShowAllBox" Content="显示全部蓝牙设备" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,10" Checked="DeviceFilter_Changed" Unchecked="DeviceFilter_Changed" />
     <Button x:Name="ConnectButton" Content="连接设备" Style="{StaticResource PrimaryButton}" Margin="0" Click="Connect_Click" />
     <Button Content="打开系统蓝牙设置" FontSize="11" Margin="0,7,0,0" Click="BluetoothSettings_Click" />
     <ListBox x:Name="SessionsList" Margin="-5,12,-5,0">
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#DFE7E1" BorderThickness="1" CornerRadius="8" Padding="9"><StackPanel>
       <DockPanel><Button Content="断开" Click="Disconnect_Click" Tag="{Binding Id}" DockPanel.Dock="Right" FontSize="10" Padding="6,3" Margin="4,0,0,0" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
       <TextBlock Text="{Binding Address}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,5" />
       <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="12" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Content="停止全部设备" Click="StopAll_Click" Foreground="#A34D38" Margin="0,8,0,0" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="收藏位置" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="FavoritesHint" Text="收藏常用地点，随时快速切换" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
     <ListBox x:Name="FavoritesList" SelectionChanged="Favorite_Selected" MaxHeight="225" Margin="-5,5,-5,0"><ListBox.ItemTemplate><DataTemplate><DockPanel>
      <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Id}" Click="DeleteFavorite_Click" Padding="5,1" Margin="3,0,0,0" ToolTip="删除收藏" />
      <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Position}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" /></StackPanel>
     </DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="配件身份" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="IdentityStatus" Text="正在检查身份…" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" />
     <TextBlock x:Name="AccessoryText" TextWrapping="Wrap" FontSize="10" Foreground="#799287" Margin="0,8,0,8" />
     <Button Content="更换配件身份" Click="RotateIdentity_Click" Margin="0" />
     <TextBlock Text="更换后对新连接的设备生效" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>

  <Border x:Name="LogPanel" Grid.Row="2" Visibility="Collapsed" Background="#182D26" Margin="18,0,18,10" CornerRadius="10" Padding="12">
   <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="诊断日志" Foreground="#D2E4D6" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="导出" Click="ExportLogs_Click" Padding="8,3" FontSize="11" /><Button Content="清空" Click="ClearLogs_Click" Padding="8,3" FontSize="11" /></StackPanel>
    <TextBox x:Name="LogBox" Height="132" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei UI" FontSize="11" Background="Transparent" Foreground="#CCE2D3" BorderThickness="0" Padding="0" />
   </DockPanel>
  </Border>
  <Border Grid.Row="3" Background="#E7EEE8" Padding="20,0"><DockPanel>
   <TextBlock DockPanel.Dock="Right" Text="定位是否生效，以设备端结果为准" VerticalAlignment="Center" Foreground="#7A8F81" FontSize="10" />
   <TextBlock x:Name="StatusText" Text="准备就绪" VerticalAlignment="Center" Foreground="#557463" FontSize="11" TextTrimming="CharacterEllipsis" />
  </DockPanel></Border>
 </Grid>
</Window>
